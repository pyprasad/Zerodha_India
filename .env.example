# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Zerodha Kite Connect API credentials
# Get from https://developers.kite.trade/
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Zerodha login credentials (for automated daily re-login)
ZERODHA_USER_ID=your_user_id_here
ZERODHA_PASSWORD=your_password_here

# TOTP secret key (from your authenticator app setup - the seed/secret, not the 6-digit code)
# Required for headless automated login
ZERODHA_TOTP_SECRET=your_totp_secret_here

# Trading capital (in INR)
TRADING_CAPITAL=100000

# Risk settings (can override config/settings.py)
MAX_DAILY_LOSS_PCT=0.02
PER_TRADE_RISK_PCT=0.005

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Mode: paper or live
TRADING_MODE=paper
